# Copie para .env e troque os valores antes de publicar

# Banco
DB_OWNER_PASSWORD=owner_dev          # dono do schema (migrações)
API_DB_PASSWORD=api_dev              # usuário da API (sujeito ao RLS, sem privilégio de dono)
METABASE_DB_PASSWORD=metabase_dev    # usuário somente leitura do BI (schema analytics)
CARREGAR_SEED=1                      # 1 = carrega dados de demonstração na primeira subida; 0 em produção
# DB_SSL=true                        # banco gerenciado (Supabase): conexão criptografada. Não precisa no Docker local.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"   # certificado do Supabase: confere o servidor

# API
JWT_SECRET=troque-por-uma-sequencia-longa-e-aleatoria
# Chave da criptografia de CPF, RG e dados bancários. Gere em apps/api com: npm run gerar-chave
# OBRIGATÓRIA em produção. Se for perdida ou trocada, esses dados não podem mais ser lidos.
DADOS_CHAVE=
APP_URL=http://localhost:3000        # endereço público do app (vai no link do profissional e no QR)
PUBLIC_API_URL=http://localhost:3001/api
# WhatsApp comercial da página de apresentação (/): só dígitos, com DDI e DDD (ex.: 5543999998888)
PUBLIC_WHATSAPP=
BI_REFRESH_MINUTES=60

# Usuário master de manutenção: entra como admin em qualquer empresa (código da empresa + este e-mail + a senha).
# Gere o hash em apps/api com: npm run hash-senha -- "SENHA"  (a senha em si nunca vai para arquivo)
# MASTER_EMAIL=voce@exemplo.com
# MASTER_NOME=Manutenção
# MASTER_SENHA_HASH='$2a$10$...'

# BI (Metabase) — preencha depois de ativar "Embedding" no Metabase
METABASE_PUBLIC_URL=http://localhost:3002
METABASE_EMBED_SECRET=
# números dos painéis liberados para incorporar, separados por vírgula (cada um com a empresa travada)
METABASE_DASHBOARDS=

# Proxies na frente da API (número de saltos, ou "loopback"). Vazio = nenhum (API exposta direto).
# Na Vercel e no Render já vale 1 sem precisar definir.
TRUST_PROXY=
